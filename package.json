{
  "name": "public-ledger",
  "version": "0.3.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:live": "tsx scripts/smoke.ts",
    "test:e2e": "playwright test",
    "format:check": "prettier --check app lib tests scripts *.ts *.json .github/workflows/*.yml",
    "format": "prettier --write app lib tests scripts *.ts *.json .github/workflows/*.yml"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.12.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "postcss": "^8.5.32"
  },
  "engines": {
    "node": ">=22.19"
  }
}
