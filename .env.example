# Optional: enables Congress.gov latest-bill discovery. Keep server-side.
CONGRESS_API_KEY=
# HTTPS_PROXY / HTTP_PROXY / NO_PROXY are honored when configured by your host.
# Node must trust your host's proxy CA (NODE_EXTRA_CA_CERTS) when applicable.
# Optional durable storage: private Vercel Blob on Vercel; an explicit directory locally.
BLOB_READ_WRITE_TOKEN=
LEDGER_DATA_DIR=
# Required to authenticate /api/internal/ingest; Vercel sends this for scheduled jobs.
CRON_SECRET=
